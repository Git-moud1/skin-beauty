# Turso (hosted libSQL) connection — used by the app and by scripts/init-db.js.
# Copy this file to ".env.local" and replace the values with your own.
# Get them with the Turso CLI (see README):
#   turso db show <your-db> --url
#   turso db tokens create <your-db>

# Looks like: libsql://your-db-name-your-org.turso.io
TURSO_DATABASE_URL=

# A long token string starting with "ey..."
TURSO_AUTH_TOKEN=

# --- Optional (recommended in production / HTTPS) ---
# Set to 1 so the session cookie is only sent over HTTPS.
# COOKIE_SECURE=1
# A long, unique secret used to sign session cookies.
# SESSION_SECRET=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# Product image uploads — Vercel Blob storage.
# REQUIRED IN PRODUCTION: Vercel's filesystem is read-only, so admin image
# uploads must go to Blob or they will not persist. If this is left blank the
# app falls back to a local data/uploads folder (fine for local dev only).
# Get it in the Vercel dashboard: Storage → create a Blob store → .env.local
# tab shows BLOB_READ_WRITE_TOKEN (starts with "vercel_blob_rw_...").
# ---------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# Owner "new order" notifications (WhatsApp + email). ALL optional:
# leave a pair blank to silently disable that channel. The dashboard alert
# always works regardless of these.
# ---------------------------------------------------------------------------

# CHANNEL 1 — WhatsApp via CallMeBot (https://www.callmebot.com/blog/free-api-whatsapp-messages/)
# Your OWNER WhatsApp number in international format (e.g. +2223XXXXXXX).
CALLMEBOT_PHONE=
# The API key CallMeBot sends back to you on WhatsApp after activation.
CALLMEBOT_APIKEY=

# CHANNEL 2 — Email via Resend (https://resend.com)
# API key from the Resend dashboard (starts with "re_").
RESEND_API_KEY=
# Where the alert email is delivered — the owner's inbox.
OWNER_EMAIL=
# Optional: the "From" address. Defaults to Resend's shared onboarding sender
# (no domain setup needed). Set this only after you verify your own domain,
# e.g. RESEND_FROM="Skin Beauty <commandes@votredomaine.com>"
# RESEND_FROM=
